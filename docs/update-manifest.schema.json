{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LS25 Hof-Dashboard Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "publishedAt", "application", "mod", "compatibility"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "const": "stable" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "application": { "$ref": "#/$defs/applicationRelease" },
    "mod": { "$ref": "#/$defs/modRelease" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "minimumApplicationVersion", "minimumModVersion"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "minimumApplicationVersion": { "$ref": "#/$defs/semver" },
        "minimumModVersion": { "$ref": "#/$defs/semver" }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "applicationRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "downloadUrl", "sha256", "sizeBytes", "releaseNotesUrl"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/philvangaatd/LS25_HofDashboard/releases/download/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "releaseNotesUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/philvangaatd/LS25_HofDashboard/releases/tag/" }
      }
    },
    "modRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "downloadUrl", "releaseNotesUrl"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/philvangaatd/LS25_HofDashboardMod/releases/download/" },
        "releaseNotesUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/philvangaatd/LS25_HofDashboardMod/releases/tag/" }
      }
    }
  }
}
